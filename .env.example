# WellTrip Environment Configuration
DEBUG=True
SECRET_KEY=dev_welltrip_secret_key_change_in_production_min_50_chars_long_and_random!
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database (Leave empty for default SQLite in local dev, or provide postgres url)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://welltrip_user:welltrip_secure_password@localhost:5432/welltrip_prod

# Axes / Security
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=0.25 # 15 minutes (in hours)

# Media Storage
MEDIA_ROOT_PATH=media/

# ------------------------------------------------------------------
# WellTrip Backend Environment Variables
# ------------------------------------------------------------------

# --- Django Core ---
DJANGO_SECRET_KEY="change-me-generate-a-long-random-string"
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.welltripthailand.com,welltripthailand.com,www.welltripthailand.com,welltrip.tanchonhomserverxxx.online,localhost,127.0.0.1

# --- CSRF (จำเป็นเมื่ออยู่หลัง HTTPS / Cloudflare Tunnel) ---
CSRF_TRUSTED_ORIGINS=https://welltripthailand.com,https://www.welltripthailand.com,https://api.welltripthailand.com,https://welltrip.tanchonhomserverxxx.online,https://welltrip.vercel.app

# --- PostgreSQL (container "db" ใน docker-compose) ---
# docker-compose สร้าง DATABASE_URL และ REDIS_URL ให้อัตโนมัติจากค่าเหล่านี้
# ใช้รหัสผ่านที่มีแค่ตัวอักษร/ตัวเลข เช่น: openssl rand -hex 24
POSTGRES_DB=welltrip_db
POSTGRES_USER=welltrip
POSTGRES_PASSWORD=CHANGE_ME

# --- Cloudflare Tunnel ---
# Zero Trust → Networks → Tunnels → Create a tunnel → copy the token
CLOUDFLARE_TUNNEL_TOKEN=

# --- Google OAuth 2.0 ---
GOOGLE_OAUTH_CLIENT_IDS=your-client-id.apps.googleusercontent.com

# --- Payee Account (Kasikornbank) ---
PAYEE_ACCOUNT_NUMBER=000-0-00000-0
PAYEE_ACCOUNT_NAME=ชื่อบัญชีผู้รับเงิน
PAYEE_BANK_NAME=ธนาคารกสิกรไทย

# --- EasySlip Automated Verification ---
SLIP_PROVIDER_URL=https://developer.easyslip.com/api/v1/verify
SLIP_PROVIDER_API_KEY=
EASYSLIP_MOCK_VERIFY=False

# --- AI APIs ---
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- Hostinger Email SMTP ---
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=welltripth@welltripthailand.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=WellTrip Thailand <welltripth@welltripthailand.com>
ADMIN_EMAIL=admin@example.com

# --- Absolute links in emails ---
SITE_URL=https://welltripthailand.com
